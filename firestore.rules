rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'modec9392@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.firebase.sign_in_provider == 'anonymous')
      );
    }

    // Public catalog collections (readable by all, manageable by Admin & PIN session)
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Client form submissions (orders, bespoke requests, training, contact)
    match /orders/{orderId} {
      allow create: if request.resource.data.prenom is string
                    && request.resource.data.nom is string
                    && request.resource.data.telephone is string
                    && request.resource.data.prenom.size() <= 100
                    && request.resource.data.nom.size() <= 100
                    && request.resource.data.telephone.size() <= 50;
      allow read, update, delete: if isAdmin();
    }

    match /custom_requests/{requestId} {
      allow create: if request.resource.data.prenom is string
                    && request.resource.data.nom is string
                    && request.resource.data.telephone is string
                    && request.resource.data.prenom.size() <= 100
                    && request.resource.data.nom.size() <= 100;
      allow read, update, delete: if isAdmin();
    }

    match /inscriptions/{inscriptionId} {
      allow create: if request.resource.data.prenom is string
                    && request.resource.data.nom is string
                    && request.resource.data.telephone is string
                    && request.resource.data.formation is string;
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if request.resource.data.prenom is string
                    && request.resource.data.nom is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
